# /etc/nginx/sites-available/voxcpm.conf
# VoxCPM2 Lightweight OpenAI-Compatible TTS API Reverse Proxy

server {
    listen 80;
    server_name tts.yourdomain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tts.yourdomain.com;

    # SSL Configuration (Certbot / Let's Encrypt)
    # ssl_certificate /etc/letsencrypt/live/tts.yourdomain.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/tts.yourdomain.com/privkey.pem;

    client_max_body_size 50M;

    # Gzip / Compression
    gzip on;
    gzip_types application/json;

    location / {
        proxy_pass http://127.0.0.1:7860;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable proxy buffering for streaming audio
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        # CORS Headers for Web Applications (Next.js, React, Laravel)
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }
    }
}
